# GPU Runner Environment Configuration
# Copy this file to .env and customize as needed

# ============================================
# Server Configuration
# ============================================
# Address to bind the HTTP server
SERVER_ADDRESS=0.0.0.0

# Port for the HTTP server
SERVER_PORT=8080

# ============================================
# Redis Configuration
# ============================================
# Redis server address (host:port)
REDIS_ADDRESS=redis:6379

# Redis password (leave empty for no authentication)
REDIS_PASSWORD=

# Redis database number
REDIS_DB=0

# Connection timeout duration (e.g., 5s, 1m)
REDIS_DIAL_TIMEOUT=5s

# Read timeout duration
REDIS_READ_TIMEOUT=3s

# Write timeout duration
REDIS_WRITE_TIMEOUT=3s

# Maximum number of retries for failed operations
REDIS_MAX_RETRIES=3

# ============================================
# Database Configuration
# ============================================
# Path to SQLite database file
DATABASE_PATH=/data/jobs.db

# ============================================
# Worker Configuration
# ============================================
# Number of concurrent job workers
WORKER_COUNT=3

# Timeout for individual job execution (e.g., 30s, 5m, 1h)
WORKER_JOB_TIMEOUT=30s

# Internal job queue capacity
WORKER_QUEUE_CAPACITY=10

# Results channel buffer size
WORKER_RESULTS_BUFFER=100

# ============================================
# Storage Configuration
# ============================================
# Volume paths for different storage tiers
STORAGE_VOLUME_10MB_PATH=/var/lib/jobrunner/volumes/10mb
STORAGE_VOLUME_25MB_PATH=/var/lib/jobrunner/volumes/25mb
STORAGE_VOLUME_50MB_PATH=/var/lib/jobrunner/volumes/50mb

# ============================================
# Logger Configuration
# ============================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Directory for log files
LOG_DIR=/var/log/gpu-runner

# Log file name
LOG_FILE=server.log

# ============================================
# CLI Configuration
# ============================================
# Default server URL for CLI commands
GPU_RUNNER_SERVER=http://0.0.0.0:8080
